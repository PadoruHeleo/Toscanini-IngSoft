# Variables de entorno para SQLx en modo offline
SQLX_OFFLINE=false

# Variables del proyecto - CONFIGURACIÓN PARA BASTION HOST
DATABASE_URL=mysql://root:your_password@127.0.0.1:3307/your_database
RESEND_API_KEY=re_your_resend_api_key_here

# Base de datos - CONFIGURACIÓN PARA TÚNEL SSH
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name

# Entorno de ejecución: "development" o "production"
APP_ENVIRONMENT=development

# Email para desarrollo (solo se usa en development)
DEV_EMAIL_RECIPIENT=your_dev_email@example.com

#Rutas SSL
DB_SSL_CA=./certs/server-ca.pem
DB_SSL_CERT=./certs/client-cert.pem
DB_SSL_KEY=./certs/client-key.pem

# SMTP variables
SMTP_SERVER=your.smtp.server.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_smtp_user@example.com

# Configuración del bastion host
BASTION_HOST=your.bastion.host.ip
BASTION_PORT=22
BASTION_USERNAME=your_bastion_username
BASTION_PRIVATE_KEY_PATH=./certs/your_private_key
BASTION_LOCAL_PORT=3306

# Configuración del servidor de base de datos real (detrás del bastion)
DB_REMOTE_HOST=your.remote.db.host.ip
DB_REMOTE_PORT=3306

# Habilitar uso del bastion host
USE_BASTION_HOST=true

# Timeout para conexiones SSH (en segundos)
SSH_CONNECT_TIMEOUT=30

# Reintentos de conexión SSH
SSH_MAX_RETRIES=3

# Intervalo entre reintentos (en segundos)
SSH_RETRY_INTERVAL=5

# Habilitar logs detallados para debugging
SSH_DEBUG=false

# Ruta para logs del túnel SSH (opcional)
SSH_LOG_PATH=./logs/ssh_tunnel.log